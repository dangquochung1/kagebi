# ---------------------------------------------------------------------------
# Original asset packs (161 MB) and font downloads.
# Kept on disk as the reproducible source for tools/build_assets.py, but never
# committed: several packs forbid redistribution (Mystic Woods, Sprout Lands).
# ---------------------------------------------------------------------------
_raw/

# Derived asset trees - regenerate with:  python tools/build_assets.py
assets/gfx/
assets/audio/
assets/atlas/

# Build output (Maven)
target/
out/
*.class
*.jar

# Standalone Windows build - rebuild with:  python tools/make_exe.py
# 289 MB of staged assets and a bundled JRE; nothing here is a source.
build/
dist/

# Scratch
tools/__pycache__/
*.pyc

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS junk - the very thing we cleaned out of the asset packs
.DS_Store
__MACOSX/
Thumbs.db
desktop.ini

# Regenerable dev previews
tools/preview/

# Regenerable review screenshots
review/

# The Top-Down Character Home pack: a source pack like the ones in _raw/, and
# kept out of git for the same reason - it shipped no licence, so it must not be
# redistributed. tools/make_village.py reads it to rebuild the village, and
# tools/build_assets.py copies its sheets into assets/gfx/tiles/home/.
homeassets/
