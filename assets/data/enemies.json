// Every enemy and both bosses. Bosses are folded in here with "boss": true -
// a boss is an enemy with more hit points and a scripted brain, and giving it
// its own file would mean two loaders and two places to forget a field.
//
// HIT POINT BUDGET. Floors are tuned to an *effective* player DPS, which is
// roughly 60% of a weapon's theoretical rate once approach, dodging and the
// target's hurtInvulnSteps are paid for. Measured against the starting katana
// (7 damage on an 18-step cycle = 23.3 theoretical, 14 effective) the floor
// averages are 14 / 26 / 40 / 62 / 84 hit points. They rise faster than the
// player's DPS does (14 / 17 / 21 / 26 / 32 with the relics a floor is
// expected to hand out), which is what makes floor 3 the wall it is meant to
// be. Arithmetic is in notes/d.md.
//
// All *Steps are fixed simulation steps at 60 to the second. All speeds are
// virtual pixels per second - the player runs at 78, so anything above that
// cannot be outrun and anything below 40 can be kited forever.
//
// "cell" is NOT uniform. Ninja Adventure trash is 16 on a 64x64 sheet of four
// directions by four frames. The depths skeletons and vampire are 32 on a
// 192x32 strip of six. The small depths idles are 16 on a 64x16 strip of four.
// giantfrog2 is 40, tengured is 82. Read the field.
{
  "enemies": [

    // ================= FLOOR 1 - The Old Well =========================
    // Nothing here has a ranged attack and nothing here is faster than the
    // player. Floor 1 teaches the swing and the roll, and a player who dies
    // on it has not understood the controls rather than the game.

    {
      "id": "slime", "nameKey": "enemy.slime.name",
      "sprite": "monsters/slime/spritesheet", "cell": 16,
      "maxHp": 16, "contactDamage": 4, "attackDamage": 0, "moveSpeed": 24,
      "brain": "hopper", "aggroRange": 90, "attackRange": 0,
      // The long cooldown is the whole lesson: it telegraphs, it lands, and
      // there is half a second afterwards in which it cannot hurt you.
      "windupSteps": 20, "activeSteps": 10, "recoverSteps": 20, "cooldownSteps": 30,
      "knockbackResist": 0.10, "hurtInvulnSteps": 10,
      "lootTable": "trash_f1", "goldMin": 2, "goldMax": 5
    },
    {
      "id": "mouse", "nameKey": "enemy.mouse.name",
      "sprite": "monsters/mouse/spritesheet", "cell": 16,
      "maxHp": 9, "contactDamage": 3, "attackDamage": 0, "moveSpeed": 52,
      "brain": "wanderer", "aggroRange": 100, "attackRange": 0,
      "windupSteps": 6, "activeSteps": 6, "recoverSteps": 10, "cooldownSteps": 20,
      "knockbackResist": 0.0, "hurtInvulnSteps": 8,
      "lootTable": "trash_f1", "goldMin": 1, "goldMax": 4
    },
    {
      "id": "bluebat", "nameKey": "enemy.bluebat.name",
      "sprite": "monsters/bluebat/spritesheet", "cell": 16,
      // Eight hit points because it dies to one katana swing. A flier that
      // survives the first hit while weaving is genuinely unpleasant at 16px.
      "maxHp": 8, "contactDamage": 4, "attackDamage": 0, "moveSpeed": 62,
      "brain": "flyer", "aggroRange": 120, "attackRange": 0,
      "windupSteps": 4, "activeSteps": 6, "recoverSteps": 8, "cooldownSteps": 24,
      "knockbackResist": 0.0, "hurtInvulnSteps": 8,
      "lootTable": "trash_f1", "goldMin": 2, "goldMax": 5,
      "flying": true
    },
    {
      "id": "larva", "nameKey": "enemy.larva.name",
      "sprite": "monsters/larva/spritesheet", "cell": 16,
      "maxHp": 22, "contactDamage": 5, "attackDamage": 0, "moveSpeed": 16,
      "brain": "chaser", "aggroRange": 70, "attackRange": 0,
      "windupSteps": 10, "activeSteps": 8, "recoverSteps": 14, "cooldownSteps": 20,
      // Resists knockback so that it cannot simply be pushed into a corner -
      // the answer is to walk away from it, which is the point of a 16px/s mob.
      "knockbackResist": 0.35, "hurtInvulnSteps": 12,
      "lootTable": "trash_f1", "goldMin": 3, "goldMax": 6
    },

    // ================= FLOOR 2 - Flooded Catacombs ====================
    // The first ranged attacker and the first ambush. Average hit points
    // nearly double while the player has at most two relics, which is why a
    // careless first-timer dies here: 42 enemies landing 30% of their hits at
    // 7.5 damage is 95 against a 100-point bar.

    {
      "id": "axolot", "nameKey": "enemy.axolot.name",
      "sprite": "monsters/axolot/spritesheet", "cell": 16,
      "maxHp": 24, "contactDamage": 5, "attackDamage": 0, "moveSpeed": 44,
      "brain": "chaser", "aggroRange": 110, "attackRange": 0,
      "windupSteps": 8, "activeSteps": 8, "recoverSteps": 12, "cooldownSteps": 18,
      "knockbackResist": 0.10, "hurtInvulnSteps": 10,
      "lootTable": "trash_f2", "goldMin": 4, "goldMax": 8
    },
    {
      "id": "kappagreen", "nameKey": "enemy.kappagreen.name",
      "sprite": "monsters/kappagreen/spritesheet", "cell": 16,
      "maxHp": 28, "contactDamage": 5, "attackDamage": 9, "moveSpeed": 34,
      "brain": "orbiter", "aggroRange": 130, "attackRange": 26,
      "windupSteps": 18, "activeSteps": 6, "recoverSteps": 18, "cooldownSteps": 40,
      "knockbackResist": 0.25, "hurtInvulnSteps": 12,
      "lootTable": "trash_f2", "goldMin": 5, "goldMax": 9
    },
    {
      "id": "kappared", "nameKey": "enemy.kappared.name",
      "sprite": "monsters/kappared/spritesheet", "cell": 16,
      "maxHp": 34, "contactDamage": 6, "attackDamage": 11, "moveSpeed": 30,
      // Charges at roughly 2.6x its walking speed, so 78 - just fast enough to
