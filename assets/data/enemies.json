      "brain": "caster", "aggroRange": 140, "attackRange": 80,
      "windupSteps": 34, "activeSteps": 8, "recoverSteps": 24, "cooldownSteps": 80,
      "knockbackResist": 0.20, "hurtInvulnSteps": 12,
      "lootTable": "trash_f3", "goldMin": 7, "goldMax": 12
    },
    {
      "id": "spirit", "nameKey": "enemy.spirit.name",
      "sprite": "monsters/spirit/spritesheet", "cell": 16,
      // Fast, flying and ranged, and 26 hit points so that it is always worth
