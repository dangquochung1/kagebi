    {
      "id": "skeleton2", "nameKey": "enemy.skeleton2.name",
      "sprite": "depths/skeleton2_idle", "cell": 32,
      "maxHp": 72, "contactDamage": 11, "attackDamage": 19, "moveSpeed": 32,
      "brain": "charger", "aggroRange": 160, "attackRange": 26,
      "windupSteps": 26, "activeSteps": 16, "recoverSteps": 26, "cooldownSteps": 50,
      "knockbackResist": 0.55, "hurtInvulnSteps": 14,
      "lootTable": "trash_f4", "goldMin": 13, "goldMax": 22
    },
    {
      "id": "vampire", "nameKey": "enemy.vampire.name",
      "sprite": "depths/vampire_idle", "cell": 32,
      // Fast enough to catch the player (50 against 78 is close once the
