    // The depths mix. These are separate defs rather than floor-4's roster at
    // higher numbers because FloorDef has no difficulty scalar - see
    // notes/d.md section 5. The weighted average works out at 84.7 hit points
    // against the 84 the pacing budget asked for.

    {
      "id": "wraith", "nameKey": "enemy.wraith.name",
      "sprite": "depths/monsters_idle/skull/v1/skull_v1", "cell": 16,
      "maxHp": 66, "contactDamage": 12, "attackDamage": 0, "moveSpeed": 58,
      "brain": "flyer", "aggroRange": 180, "attackRange": 0,
      "windupSteps": 8, "activeSteps": 8, "recoverSteps": 12, "cooldownSteps": 26,
      "knockbackResist": 0.0, "hurtInvulnSteps": 8,
      "lootTable": "trash_f5", "goldMin": 14, "goldMax": 23,
      "flying": true
    },
    {
      "id": "acolyte", "nameKey": "enemy.acolyte.name",
      "sprite": "depths/priests_idle/priest1/v1/priest1_v1", "cell": 16,
      "maxHp": 74, "contactDamage": 10, "attackDamage": 21, "moveSpeed": 30,
      // Casts "flamewave". The 90-step windup is the longest telegraph in the
