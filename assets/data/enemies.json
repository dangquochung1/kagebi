    {
      // ---- the Drowned Cove -------------------------------------------
      //
      // Three slimes with three ways of reaching the player, because a floor
      // whose whole roster closes to arm's length teaches nothing the first
      // five have not already taught. Between them they cover the three
      // answers the game has: stand somewhere else, get out of the ring, and
      // kill it before it arrives.
      //
      // Their art is a directional set - one sheet per animation, all four
      // facings - so unlike the 16px monsters they have a real hurt, a real
      // death and a run cycle. The cell is 64 because the attack frames need
      // the width; the bodies inside are about a quarter of that.
      "id": "slimespike", "nameKey": "enemy.slimespike.name",
      "sprite": "slimes/slimespike/idle", "cell": 64,
      // The cove's floor mob, and the one that reads as ordinary so the other
      // two read as strange. It swings rather than bumping, which is what the
      // spike burst in its attack sheet is drawn as.
      "maxHp": 44, "contactDamage": 5, "attackDamage": 9, "moveSpeed": 40,
      "brain": "chaser", "aggroRange": 110, "attackRange": 16,
      "windupSteps": 18, "activeSteps": 8, "recoverSteps": 18, "cooldownSteps": 34,
      "knockbackResist": 0.15, "hurtInvulnSteps": 10,
      "lootTable": "trash_f6", "goldMin": 5, "goldMax": 10
    },
    {
      "id": "slimetide", "nameKey": "enemy.slimetide.name",
      "sprite": "slimes/slimetide/idle", "cell": 64,
      // Bursts a ring rather than aiming a shot, so the dodge is a distance
      // and not a direction. Softest of the three: dangerous at the range it
      // wants to hold, and helpless once that range is closed.
      "maxHp": 36, "contactDamage": 4, "attackDamage": 7, "moveSpeed": 34,
      "brain": "burster", "aggroRange": 150, "attackRange": 84,
      "windupSteps": 26, "activeSteps": 4, "recoverSteps": 22, "cooldownSteps": 70,
      "knockbackResist": 0.0, "hurtInvulnSteps": 10,
      "lootTable": "trash_f6", "goldMin": 6, "goldMax": 11
    },
    {
