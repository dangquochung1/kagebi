    {
      "id": "skeleton1", "nameKey": "enemy.skeleton1.name",
      "sprite": "depths/skeleton1_idle", "cell": 32,
      "maxHp": 56, "contactDamage": 9, "attackDamage": 15, "moveSpeed": 38,
