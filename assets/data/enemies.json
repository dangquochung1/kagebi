    // ================= BOSSES =========================================

    {
      "id": "giantfrog2", "nameKey": "enemy.giantfrog2.name",
      // Bosses are horizontal strips, one region per animation. The brain
      // names the others: bosses/giantfrog2/{attack,charge,hit,jump}.
      "sprite": "bosses/giantfrog2/idle", "cell": 40,
      // 520 hit points. It was 900, which was right when the game was one
      // descent and a player arrived at floor 3 carrying four floors' worth of
      // relics; a stage starts from nothing, so the same 900 came to 117
      // seconds of unbroken swinging on the starting katana. 520 is about a
      // minute, which is a fight rather than a chore. See BalanceTest.stageDps.
      "maxHp": 520, "contactDamage": 12, "attackDamage": 22, "moveSpeed": 46,
      "brain": "boss_frog", "aggroRange": 999, "attackRange": 72,
      "windupSteps": 30, "activeSteps": 18, "recoverSteps": 36, "cooldownSteps": 60,
      // Immovable. A boss that can be knocked back is a boss that can be
      // pinned against a wall and never allowed to act.
      "knockbackResist": 1.0, "hurtInvulnSteps": 6,
      "lootTable": "boss_f3", "goldMin": 60, "goldMax": 100,
      "boss": true, "phases": 1
    },
    {
      "id": "tengured", "nameKey": "enemy.tengured.name",
      "sprite": "bosses/tengured/idle", "cell": 82,
      // The player's own master. 880 across two phases of 440; at half hit
      // points the fight stops and plays bosses/tengured/trans, which is the
      // only place the story is told without a line of text.
      //
      // It was 1800, and stages made that unplayable rather than hard: nearly
      // four minutes of the same four attacks with the starting katana, since
      // nobody arrives at stage 5 with stage 1-4's relics any more. Still the
      // longest fight in the game at 880, which is what a last boss should be.
      "maxHp": 880, "contactDamage": 16, "attackDamage": 30, "moveSpeed": 64,
      "brain": "boss_tengu", "aggroRange": 999, "attackRange": 90,
      "windupSteps": 26, "activeSteps": 14, "recoverSteps": 30, "cooldownSteps": 48,
      "knockbackResist": 1.0, "hurtInvulnSteps": 5,
      "lootTable": "boss_f5", "goldMin": 150, "goldMax": 250,
      "boss": true, "phases": 2, "flying": true
    },
    {
      // ---- the Drowned Cove's boss: one fight, five bodies -------------
      //
      //   pirateleader -> fireorb -> piratezombie -> waterorb -> squidman
      //
      // Five defs rather than one with phases, because each body has its own
      // full health bar - the player is told three times that they have won
      // something, and three times that it was not enough. `phases` cuts one
      // bar into slices and plays a trans strip between them, which is
      // tengured's fight and needs art these packs do not ship.
      //
      // Each link names the next in `evolvesInto` and its brain summons it on
      // death, so the chain is readable here rather than spelled out across
      // five Java classes. ContentValidator walks it: a link that names
      // nothing that exists, or names a loop, fails the build.
      //
      // 560 across the three bodies, against tengured's 880 on one. The whole
      // chain has to fit inside FullRunTest's two minutes of a bot swinging a
      // starting katana, and sixteen seconds of that are the two orbs, which
      // cannot be hurt at all.
      "id": "pirateleader", "nameKey": "enemy.pirateleader.name",
      "sprite": "bosses6/pirateleader/idle", "cell": 64,
      // Melee only, on purpose. He has a charge, a swing, and a combo that
      // walks the player backwards; everything he does he does by arriving.
      // The two bodies after him are both ranged, so he is what they are an
      // escalation from.
      "maxHp": 200, "contactDamage": 12, "attackDamage": 24, "moveSpeed": 58,
      "brain": "boss_pirateleader", "aggroRange": 999, "attackRange": 26,
      // activeSteps is the SWING, and only the swing. It carried the combo's
      // 190 until the combo learned to ask for its own window - and every
      // ordinary swing he threw stood open for those 190 steps too, which is
      // over three seconds of one animation and was reported as the chém
      // being broken. See BossBrain.activeSteps: each move now names its own.
      "windupSteps": 28, "activeSteps": 16, "recoverSteps": 34, "cooldownSteps": 54,
      "knockbackResist": 1.0, "hurtInvulnSteps": 5,
      "lootTable": "nothing", "goldMin": 0, "goldMax": 0,
      "boss": true, "evolvesInto": "fireorb"
    },
    {
      "id": "fireorb", "nameKey": "enemy.fireorb.name",
      // No body of its own: build_cove.py writes the fireball strip a second
      // time as a four-column actor sheet, because ActorSprites only ever
      // reads the actors atlas and an orb has to stand in the room like
      // anything else the player can see.
      "sprite": "bosses6/fireorb/idle", "cell": 32,
      // Untouchable, immobile, and on a timer - OrbBrain grants it i-frames
      // longer than it can live and kills it itself when its eight seconds
      // are up. The hit points are what the bar would show if anything could
      // ever take one off it.
      "maxHp": 1, "contactDamage": 0, "attackDamage": 14, "moveSpeed": 0,
      "brain": "boss_orb", "aggroRange": 999, "attackRange": 1,
      "windupSteps": 1, "activeSteps": 1, "recoverSteps": 1, "cooldownSteps": 1,
      "knockbackResist": 1.0, "hurtInvulnSteps": 0,
      "lootTable": "nothing", "goldMin": 0, "goldMax": 0,
      "boss": true, "evolvesInto": "piratezombie",
      "projectile": "fx/skill6/fire_spell"
    },
    {
      "id": "piratezombie", "nameKey": "enemy.piratezombie.name",
      "sprite": "bosses6/piratezombie/idle", "cell": 64,
      // The same fight at range: a three-arrow fan, a barrage down one line,
      // and a wall of burning ground that cuts the arena in half. At 40% it
