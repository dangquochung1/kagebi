      "maxHp": 26, "contactDamage": 6, "attackDamage": 12, "moveSpeed": 56,
      "brain": "flyer", "aggroRange": 170, "attackRange": 110,
      "windupSteps": 20, "activeSteps": 4, "recoverSteps": 16, "cooldownSteps": 70,
      "knockbackResist": 0.0, "hurtInvulnSteps": 8,
      "lootTable": "trash_f3", "goldMin": 8, "goldMax": 14,
      "flying": true
    },
    {
      "id": "reptile", "nameKey": "enemy.reptile.name",
      "sprite": "monsters/reptile/spritesheet", "cell": 16,
      "maxHp": 58, "contactDamage": 9, "attackDamage": 14, "moveSpeed": 40,
      "brain": "charger", "aggroRange": 160, "attackRange": 22,
      "windupSteps": 22, "activeSteps": 16, "recoverSteps": 22, "cooldownSteps": 44,
      "knockbackResist": 0.45, "hurtInvulnSteps": 12,
      "lootTable": "trash_f3", "goldMin": 9, "goldMax": 15
    },

    // ================= FLOOR 4 - The Cursed Depths ====================
    // A different pack, a different palette, and a 32px frame rather than a
