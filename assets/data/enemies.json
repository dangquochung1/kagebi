      "brain": "caster", "aggroRange": 170, "attackRange": 100,
      "windupSteps": 90, "activeSteps": 10, "recoverSteps": 30, "cooldownSteps": 110,
      "knockbackResist": 0.35, "hurtInvulnSteps": 12,
      "lootTable": "trash_f5", "goldMin": 16, "goldMax": 26
    },
    {
      "id": "zealot", "nameKey": "enemy.zealot.name",
      "sprite": "depths/priests_idle/priest3/v1/priest3_v1", "cell": 16,
      "maxHp": 92, "contactDamage": 13, "attackDamage": 24, "moveSpeed": 36,
      "brain": "shooter", "aggroRange": 180, "attackRange": 120,
      "windupSteps": 28, "activeSteps": 6, "recoverSteps": 22, "cooldownSteps": 64,
      "knockbackResist": 0.45, "hurtInvulnSteps": 14,
      "lootTable": "trash_f5", "goldMin": 18, "goldMax": 29
    },
    {
      "id": "bonelord", "nameKey": "enemy.bonelord.name",
      "sprite": "depths/monsters_idle/skeleton2/v2/skeleton2_v2", "cell": 16,
