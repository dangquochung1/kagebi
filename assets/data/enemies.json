      "brain": "charger", "aggroRange": 140, "attackRange": 20,
      "windupSteps": 26, "activeSteps": 14, "recoverSteps": 24, "cooldownSteps": 50,
      "knockbackResist": 0.40, "hurtInvulnSteps": 12,
      "lootTable": "trash_f2", "goldMin": 6, "goldMax": 11
    },
    {
      "id": "octopus", "nameKey": "enemy.octopus.name",
      "sprite": "monsters/octopus/spritesheet", "cell": 16,
      // The first thing in the game that can hit the player from across a
      // room, so it is also the softest thing on the floor. Fires "inkball".
      "maxHp": 20, "contactDamage": 4, "attackDamage": 8, "moveSpeed": 26,
      "brain": "shooter", "aggroRange": 150, "attackRange": 96,
      "windupSteps": 22, "activeSteps": 4, "recoverSteps": 20, "cooldownSteps": 60,
      "knockbackResist": 0.0, "hurtInvulnSteps": 10,
      "lootTable": "trash_f2", "goldMin": 4, "goldMax": 8
    },
    {
      "id": "mollusc", "nameKey": "enemy.mollusc.name",
      "sprite": "monsters/mollusc/spritesheet", "cell": 16,
      "maxHp": 30, "contactDamage": 6, "attackDamage": 0, "moveSpeed": 18,
      // Reads as scenery until stepped near. 0.6 knockback resist means a
      // katana cannot shove it back out of its own lunge.
      "brain": "ambusher", "aggroRange": 40, "attackRange": 0,
      "windupSteps": 12, "activeSteps": 10, "recoverSteps": 26, "cooldownSteps": 40,
      "knockbackResist": 0.60, "hurtInvulnSteps": 14,
      "lootTable": "trash_f2", "goldMin": 5, "goldMax": 9
    },

    // ================= FLOOR 3 - Broken Shrine ========================
    // The intended wall. Packs of four to five at 40 average hit points
    // against a player carrying three or four relics, plus the first boss.

    {
      "id": "mushroom", "nameKey": "enemy.mushroom.name",
      "sprite": "monsters/mushroom/spritesheet", "cell": 16,
      "maxHp": 44, "contactDamage": 7, "attackDamage": 0, "moveSpeed": 30,
      // Splits once into two half-HP copies. One generation only, or a room
      // of six becomes a room of ninety-six.
      "brain": "splitter", "aggroRange": 110, "attackRange": 0,
      "windupSteps": 10, "activeSteps": 8, "recoverSteps": 14, "cooldownSteps": 22,
      "knockbackResist": 0.30, "hurtInvulnSteps": 12,
      "lootTable": "trash_f3", "goldMin": 7, "goldMax": 12
    },
    {
      "id": "mushroom2", "nameKey": "enemy.mushroom2.name",
      "sprite": "monsters/mushroom2/spritesheet", "cell": 16,
      "maxHp": 30, "contactDamage": 6, "attackDamage": 10, "moveSpeed": 26,
      // Stationary while casting; drops "sporecloud", which lingers. The first
