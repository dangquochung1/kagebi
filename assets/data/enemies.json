      "maxHp": 130, "contactDamage": 16, "attackDamage": 28, "moveSpeed": 26,
      "brain": "charger", "aggroRange": 170, "attackRange": 30,
      "windupSteps": 36, "activeSteps": 20, "recoverSteps": 34, "cooldownSteps": 70,
      "knockbackResist": 0.80, "hurtInvulnSteps": 16,
      "lootTable": "elite", "goldMin": 26, "goldMax": 44
    },

    // ================= BOSSES =========================================

    {
      "id": "giantfrog2", "nameKey": "enemy.giantfrog2.name",
      // Bosses are horizontal strips, one region per animation. The brain
      // names the others: bosses/giantfrog2/{attack,charge,hit,jump}.
      "sprite": "bosses/giantfrog2/idle", "cell": 40,
      // 900 hit points is about 43 seconds against the DPS a player reaching
      // floor 3 is expected to have (21), and closer to 70 in practice once
      // the hop-slam forces them to disengage. Long enough to be a fight,
      // short enough that losing does not cost ten minutes.
      "maxHp": 900, "contactDamage": 12, "attackDamage": 22, "moveSpeed": 46,
      "brain": "boss_frog", "aggroRange": 999, "attackRange": 72,
      "windupSteps": 30, "activeSteps": 18, "recoverSteps": 36, "cooldownSteps": 60,
      // Immovable. A boss that can be knocked back is a boss that can be
      // pinned against a wall and never allowed to act.
      "knockbackResist": 1.0, "hurtInvulnSteps": 6,
      "lootTable": "boss_f3", "goldMin": 60, "goldMax": 100,
      "boss": true, "phases": 1
    },
    {
      "id": "tengured", "nameKey": "enemy.tengured.name",
      "sprite": "bosses/tengured/idle", "cell": 82,
      // The player's own master. 1800 across two phases of 900; at half hit
      // points the fight stops and plays bosses/tengured/trans, which is the
      // only place the story is told without a line of text.
      "maxHp": 1800, "contactDamage": 16, "attackDamage": 30, "moveSpeed": 64,
      "brain": "boss_tengu", "aggroRange": 999, "attackRange": 90,
      "windupSteps": 26, "activeSteps": 14, "recoverSteps": 30, "cooldownSteps": 48,
