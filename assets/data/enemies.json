      "brain": "flyer", "aggroRange": 120, "attackRange": 0,
      "windupSteps": 4, "activeSteps": 6, "recoverSteps": 8, "cooldownSteps": 24,
      "knockbackResist": 0.0, "hurtInvulnSteps": 8,
