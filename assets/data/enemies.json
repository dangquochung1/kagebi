      "maxHp": 58, "contactDamage": 10, "attackDamage": 17, "moveSpeed": 50,
      "brain": "ambusher", "aggroRange": 90, "attackRange": 22,
      "windupSteps": 14, "activeSteps": 10, "recoverSteps": 18, "cooldownSteps": 40,
      "knockbackResist": 0.25, "hurtInvulnSteps": 10,
      "lootTable": "trash_f4", "goldMin": 12, "goldMax": 21
    },

